{
  "schemaVersion": 1,
  "id": "chainitemhangings",
  "version": "${version}",
  "name": "Connectible Chains: Customizations",
  "description": "Addon for Reconnectible Chains: choose which items hang on chains, draw them as their block or their item texture, and set scale, offset and rotation per item from an in-game menu.",
  "authors": [
    "Craig Cahoon"
  ],
  "contact": {
    "email": "the.real.cogamer103@gmail.com"
  },
  "license": "LGPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "chainitemhangings.HangingToolMod"
    ],
    "client": [
      "chainitemhangings.client.HangingToolClient"
    ]
  },
  "mixins": [
    "chainitemhangings.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.9.0",
    "connectiblechains": ">=2.4.3"
  },
  "icon": "assets/chainitemhangings/icon.png"
}
